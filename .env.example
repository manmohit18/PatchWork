# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_USER=patchwork
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=patchwork
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://patchwork:replace-with-a-local-password@127.0.0.1:5433/patchwork?schema=public
TEST_DATABASE_URL=postgresql://patchwork:replace-with-a-local-password@127.0.0.1:5433/patchwork_test?schema=public

APP_ORIGIN=http://localhost:3000
API_PORT=4000
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback
